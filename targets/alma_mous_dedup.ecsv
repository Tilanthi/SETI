# %ECSV 1.0
# ---
# datatype:
# - name: member_ous_uid
#   datatype: string
#   description: Member OUS ID
#   meta: !!omap
#   - {xtype: 'adql:VARCHAR'}
#   - {_votable_string_dtype: char}
# - name: target_name
#   datatype: string
#   description: name of intended target
#   meta: !!omap
#   - {ucd: meta.id;src}
#   - {utype: 'obscore:Target.Name'}
#   - {_votable_string_dtype: char}
# - name: s_ra
#   unit: deg
#   datatype: float64
#   description: RA of central coordinates
#   meta: !!omap
#   - {ucd: pos.eq.ra}
#   - {utype: 'obscore:Char.SpatialAxis.Coverage.Location.Coord.Position2D.Value2.C1'}
#   - {xtype: 'adql:DOUBLE'}
# - name: s_dec
#   unit: deg
#   datatype: float64
#   description: DEC of central coordinates
#   meta: !!omap
#   - {ucd: pos.eq.dec}
#   - {utype: 'obscore:Char.SpatialAxis.Coverage.Location.Coord.Position2D.Value2.C2'}
#   - {xtype: 'adql:DOUBLE'}
# - name: band_list
#   datatype: string
#   description: Space delimited list of bands
#   meta: !!omap
#   - {xtype: 'adql:VARCHAR'}
#   - {_votable_string_dtype: char}
# - name: science_keyword
#   datatype: string
#   meta: !!omap
#   - {xtype: 'adql:VARCHAR'}
#   - {_votable_string_dtype: char}
# - name: scientific_category
#   datatype: string
#   meta: !!omap
#   - {xtype: 'adql:VARCHAR'}
#   - {_votable_string_dtype: char}
# - name: t_exptime
#   unit: s
#   datatype: float64
#   description: exposure time of observation
#   meta: !!omap
#   - {ucd: time.duration;obs.exposure}
#   - {utype: 'obscore:Char.TimeAxis.Coverage.Support.Extent'}
#   - {xtype: 'adql:DOUBLE'}
# - name: em_resolution
#   unit: m
#   datatype: float64
#   description: Estimated frequency resolution from all the spectral windows, using median values of channel widths.
#   meta: !!omap
#   - {ucd: spect.resolution;stat.mean}
#   - {utype: 'obscore:Char.SpectralAxis.Resolution.refval.value'}
#   - {xtype: 'adql:DOUBLE'}
# - name: spectral_resolution
#   unit: kHz
#   datatype: float64
#   meta: !!omap
#   - {xtype: 'adql:DOUBLE'}
# - name: proposal_id
#   datatype: string
#   description: Identifier of proposal to which NO observation belongs.
#   meta: !!omap
#   - {ucd: meta.id;obs.proposal}
#   - {utype: 'obscore:Provenance.Proposal.identifier'}
#   - {xtype: 'adql:VARCHAR'}
#   - {_votable_string_dtype: char}
# - name: is_mosaic
#   datatype: string
#   description: Flag to indicate if this ASDM represents a mosaic or not.
#   meta: !!omap
#   - {xtype: 'adql:CHAR'}
#   - {_votable_string_dtype: char}
# - name: antenna_arrays
#   datatype: string
#   description: Blank-separated list of Pad:Antenna pairs, i.e., A109:DV09 J504:DV02 J505:DV05 for antennas DV09, DV02 and DV05 sitting
#     on pads A109, J504, and J505, respectively.
#   meta: !!omap
#   - {ucd: meta.code.member;instr.setup}
#   - {xtype: 'adql:VARCHAR'}
#   - {_votable_string_dtype: char}
# - name: s_fov
#   unit: deg
#   datatype: float64
#   description: size of the region covered (~diameter of minimum bounding circle)
#   meta: !!omap
#   - {ucd: phys.angSize;instr.fov}
#   - {utype: 'obscore:Char.SpatialAxis.Coverage.Bounds.Extent.diameter'}
#   - {xtype: 'adql:DOUBLE'}
# - name: obs_release_date
#   datatype: string
#   description: timestamp of date the data becomes publicly available
#   meta: !!omap
#   - {ucd: time.release}
#   - {utype: 'obscore:Curation.releaseDate'}
#   - {xtype: 'adql:TIMESTAMP'}
#   - {_votable_string_dtype: char}
#   subtype: json
# - name: first_author
#   datatype: string
#   description: The first author as provided by <a href="http://telbib.eso.org">telbib.eso.org</a>.
#   meta: !!omap
#   - {xtype: 'adql:VARCHAR'}
#   - {_votable_string_dtype: char}
# - name: pwv
#   unit: mm
#   datatype: float32
#   description: Estimated precipitable water vapour from the XML_CALWVR_ENTITIES table.
#   meta: !!omap
#   - {ucd: obs.atmos.extinction}
#   - {xtype: 'adql:FLOAT'}
# schema: astropy-2.0
member_ous_uid target_name s_ra s_dec band_list science_keyword scientific_category t_exptime em_resolution spectral_resolution proposal_id is_mosaic antenna_arrays s_fov obs_release_date first_author pwv
