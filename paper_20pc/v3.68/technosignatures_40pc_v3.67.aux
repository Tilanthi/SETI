\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Line-attribution audit through the frame \relax \fontsize  {7}{8}\selectfont  chain of \S  \ref  {sec:frames}: the three line-attributed windows, and the Class\nobreakspace  {}A $\beta $\nobreakspace  {}Pictoris Band\nobreakspace  {}6 window that is no stage-1 outlier yet shows the same CO component. Topocentric offsets are observed minus catalogued laboratory rest frequency \citep  {Pickett1998}, so a negative offset means the observed frequency lies below rest. The barycentric correction is the Earth-ephemeris term at the execution-block mid-time. The AU\nobreakspace  {}Mic systemic velocity is catalogued \citep  {Fouque2018}. For $\beta $\nobreakspace  {}Pictoris we adopt $v_{\rm  sys}=+20.0\pm 0.7$\,km\,s$^{-1}$ \citep  {Matra2017} rather than the \emph  {Gaia}\nobreakspace  {}DR3 value of $+16.84$\,km\,s$^{-1}$ \citep  {GaiaDR3}, because the star is an A6V rotator inside the hot-star template regime in which DR3 radial velocities carry a known systematic \citep  {Blomme2023}.}}{29}{table.15}\protected@file@percent }
\newlabel{tab:bpicaudit}{{15}{29}{Line-attribution audit through the frame \scriptsize chain of \S \ref {sec:frames}: the three line-attributed windows, and the Class~A $\beta $~Pictoris Band~6 window that is no stage-1 outlier yet shows the same CO component. Topocentric offsets are observed minus catalogued laboratory rest frequency \citep {Pickett1998}, so a negative offset means the observed frequency lies below rest. The barycentric correction is the Earth-ephemeris term at the execution-block mid-time. The AU~Mic systemic velocity is catalogued \citep {Fouque2018}. For $\beta $~Pictoris we adopt $v_{\rm sys}=\VsysBpic \pm \VsysBpicErr $\,km\,s$^{-1}$ \citep {Matra2017} rather than the \emph {Gaia}~DR3 value of $+16.84$\,km\,s$^{-1}$ \citep {GaiaDR3}, because the star is an A6V rotator inside the hot-star template regime in which DR3 radial velocities carry a known systematic \citep {Blomme2023}}{table.15}{}}
