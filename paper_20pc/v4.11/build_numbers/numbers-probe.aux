\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \emph  {(a)}\nobreakspace  {}Class\nobreakspace  {}A sensitivity: the cumulative number of systems whose best window reaches a given $\mathrm  {EIRP}_{90}$, the power at which nine carriers in ten are recovered through the trigger and the spatial screen together. The shaded band is the combined interval of Table\nobreakspace  {}\ref  {tab:p90budget}. \emph  {(b)}\nobreakspace  {}The temporal selection function: systems grouped by the longest separation between their searched epochs, an independent epoch being a separation of more than 1{} day. \textbf  {For the 27{} systems observed in a single block, and the 13{} whose blocks all fall within one day --- left of the dashed line --- independent confirmation was not possible at all}, whatever the sensitivity in panel\nobreakspace  {}(a). Recurrence over years can be tested for 23{} systems of 82.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:classasens}{{5}{9}{\emph {(a)}~Class~A sensitivity: the cumulative number of systems whose best window reaches a given $\mathrm {EIRP}_{90}$, the power at which nine carriers in ten are recovered through the trigger and the spatial screen together. The shaded band is the combined interval of Table~\ref {tab:p90budget}. \emph {(b)}~The temporal selection function: systems grouped by the longest separation between their searched epochs, an independent epoch being a separation of more than \EpSep {} day. \textbf {For the \EpOne {} systems observed in a single block, and the \EpSameDay {} whose blocks all fall within one day --- left of the dashed line --- independent confirmation was not possible at all}, whatever the sensitivity in panel~(a). Recurrence over years can be tested for \EpYears {} systems of \EpTot }{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}$\beta $\nobreakspace  {}Pictoris: an astrophysical positive control, and the obstacle it identifies}{9}{subsection.5.4}\protected@file@percent }
\newlabel{sec:bpicval}{{5.4}{9}{$\beta $~Pictoris: an astrophysical positive control, and the obstacle it identifies}{subsection.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The $\beta $\nobreakspace  {}Pictoris positive control, in both directions. \emph  {(a)}\nobreakspace  {}The spatial screen. One point per execution block in which the blind search recovers circumstellar carbon monoxide, plotted as the stellar statistic against the maximum over that window's 512{} control positions: the 9{} blocks in which the star outranks every control, and one further block in which the ring wins. \emph  {The control is that the search recovers a real narrow line at a stellar position, in two transitions and in every one of these blocks.} It is not that the star outranks the ring everywhere. Where the disc is resolved on the scale of the primary beam the screen rejects emission that is real, centred on the star and independently mapped, so \textbf  {the screen measures compactness and not authenticity} (\S  \ref  {sec:bpicval}). \emph  {(b)}\nobreakspace  {}Line confusion, which is what makes the screen's job hard. The same crossings are plotted by their velocity offset from the nearest catalogued transition, against the mask half-width; the adopted $\pm 50$\,km\,s$^{-1}$ is marked. Every $\beta $\nobreakspace  {}Pictoris carbon-monoxide crossing lands a few tens of km\,s$^{-1}$ from CO, well inside the mask, while the two CS($5{\to }4$) crossings of the same star sit thousands of km\,s$^{-1}$ from anything catalogued and are not attributed at any width. The survey's remaining crossings are in grey, with HD\nobreakspace  {}48370 marked. \emph  {A crossing is identified by where it falls in this plane and not by how strong it is}, which is why the line mask and not the trigger is the productive test.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:bpiccontrol}{{6}{10}{The $\beta $~Pictoris positive control, in both directions. \emph {(a)}~The spatial screen. One point per execution block in which the blind search recovers circumstellar carbon monoxide, plotted as the stellar statistic against the maximum over that window's \NCtrl {} control positions: the \NStageOneBpicEb {} blocks in which the star outranks every control, and one further block in which the ring wins. \emph {The control is that the search recovers a real narrow line at a stellar position, in two transitions and in every one of these blocks.} It is not that the star outranks the ring everywhere. Where the disc is resolved on the scale of the primary beam the screen rejects emission that is real, centred on the star and independently mapped, so \textbf {the screen measures compactness and not authenticity} (\S \ref {sec:bpicval}). \emph {(b)}~Line confusion, which is what makes the screen's job hard. The same crossings are plotted by their velocity offset from the nearest catalogued transition, against the mask half-width; the adopted $\pm \MaskHalfKms $\,km\,s$^{-1}$ is marked. Every $\beta $~Pictoris carbon-monoxide crossing lands a few tens of km\,s$^{-1}$ from CO, well inside the mask, while the two CS($5{\to }4$) crossings of the same star sit thousands of km\,s$^{-1}$ from anything catalogued and are not attributed at any width. The survey's remaining crossings are in grey, with HD~48370 marked. \emph {A crossing is identified by where it falls in this plane and not by how strong it is}, which is why the line mask and not the trigger is the productive test}{figure.6}{}}
