\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Where this survey searched, and where a repeat could test it}: independent systems covering each sky frequency, one panel per populated ALMA band, its width proportional to the band's frequency share; curves step at the searched window edges. \emph  {(a)}\nobreakspace  {}Every window: blue, the fine-channel carrier search (Class\nobreakspace  {}A); grey, the coarse-channel spectral-excess search (Class\nobreakspace  {}B); the summed window bandwidth is $24.1\times $ the union. \emph  {(b)}\nobreakspace  {}Class\nobreakspace  {}A: detectable once (grey); with a \emph  {separated} block (\S  \ref  {sec:summary}) covering the frequency (blue); beyond a year (dark). An accelerating carrier further needs a predicted frequency within the repeat coverage, with adequate sensitivity. \emph  {(c)}\nobreakspace  {}Class\nobreakspace  {}A systems recovering a carrier of that EIRP nine times in ten in one epoch; dashed, $1\times 10^{15}$\,W.}}{4}{figure.2.2}\protected@file@percent }
\newlabel{fig:waterfall}{{2}{4}{\textbf {Where this survey searched, and where a repeat could test it}: independent systems covering each sky frequency, one panel per populated ALMA band, its width proportional to the band's frequency share; curves step at the searched window edges. \emph {(a)}~Every window: blue, the fine-channel carrier search (Class~A); grey, the coarse-channel spectral-excess search (Class~B); the summed window bandwidth is $\GrossOverUnion \times $ the union. \emph {(b)}~Class~A: detectable once (grey); with a \emph {separated} block (\S \ref {sec:summary}) covering the frequency (blue); beyond a year (dark). An accelerating carrier further needs a predicted frequency within the repeat coverage, with adequate sensitivity. \emph {(c)}~Class~A systems recovering a carrier of that EIRP nine times in ten in one epoch; dashed, $\CovEirpRefTex $\,W}{figure.2.2}{}}
