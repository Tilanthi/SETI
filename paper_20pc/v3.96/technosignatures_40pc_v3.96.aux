\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces \textbf  {Every false-alarm expectation quoted in this paper, and what each one predicts.} The first six predict the number of windows in which a no-signal position would \emph  {rank first} among the control ensemble; they differ in sample, denominator and whether the measured tail excess and the within-block clustering are included, and they are pipeline diagnostics. A stage-1 event also requires the position to reach the trigger, so only the last row, which imposes that condition, may be compared with an observed count; it is the comparison used in the abstract, in \S  \ref  {sec:technosearch} and in the conclusions. Square brackets give a bootstrap interval on the \emph  {expectation}, round brackets the 95 per cent interval of the predicted \emph  {count} under that expectation.}}{32}{table.16}\protected@file@percent }
\newlabel{tab:falsealarm}{{16}{32}{\textbf {Every false-alarm expectation quoted in this paper, and what each one predicts.} The first six predict the number of windows in which a no-signal position would \emph {rank first} among the control ensemble; they differ in sample, denominator and whether the measured tail excess and the within-block clustering are included, and they are pipeline diagnostics. A stage-1 event also requires the position to reach the trigger, so only the last row, which imposes that condition, may be compared with an observed count; it is the comparison used in the abstract, in \S \ref {sec:technosearch} and in the conclusions. Square brackets give a bootstrap interval on the \emph {expectation}, round brackets the 95 per cent interval of the predicted \emph {count} under that expectation}{table.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces The on-star cell excess, decomposed. Top: what is observed against an iid-Gaussian budget. Middle: the two multiplicative parts of that factor. Bottom: the same correlation correction applied to the control maxima, which are measured in the same units and calibrate the budget empirically.}}{32}{table.17}\protected@file@percent }
\newlabel{tab:excess}{{17}{32}{The on-star cell excess, decomposed. Top: what is observed against an iid-Gaussian budget. Middle: the two multiplicative parts of that factor. Bottom: the same correlation correction applied to the control maxima, which are measured in the same units and calibrate the budget empirically}{table.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Array-split robustness. The control geometry uses a 12-m $\theta _{\rm  PB}$ for every window, so the ACA 7-m stratum carries a known geometric error. Expected rank-first counts are $N_{\rm  win}/(512+1)$ under exchangeability, and are therefore lower bounds: the measured tail rate is a factor 1.4{} higher (\S  \ref  {sec:empiricalfa}), which brings the 12\,m stratum's 9{} observed within one of expectation. No disposition and no headline threshold depends on the ACA windows.}}{32}{table.18}\protected@file@percent }
\newlabel{tab:arraysplit}{{18}{32}{Array-split robustness. The control geometry uses a 12-m $\theta _{\rm PB}$ for every window, so the ACA 7-m stratum carries a known geometric error. Expected rank-first counts are $N_{\rm win}/(\NCtrl +1)$ under exchangeability, and are therefore lower bounds: the measured tail rate is a factor \PseudoFirstRatio {} higher (\S \ref {sec:empiricalfa}), which brings the 12\,m stratum's \NStageOneTwelveM {} observed within one of expectation. No disposition and no headline threshold depends on the ACA windows}{table.18}{}}
