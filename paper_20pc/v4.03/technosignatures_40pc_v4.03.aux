\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces The archival selection, which no limit in this paper escapes. Grey: the spectral-class composition of the Gaia\nobreakspace  {}DR3 objects within 40\,pc that carry a temperature. Blue: the same for the searched sample. Counts are printed above each bar. The sample is enriched in F and G stars by factors of four and three and depleted in M\nobreakspace  {}dwarfs by a factor two, so 21{} of the 5\,908{} classified M\nobreakspace  {}dwarfs within 40\,pc carry a searched window. Because M\nobreakspace  {}dwarfs host most of the habitable-zone planets in the solar neighbourhood, this is the single most important limitation on what the null result means (\S  \ref  {sec:bias}).}}{29}{figure.12}\protected@file@percent }
\newlabel{fig:selbias}{{12}{29}{The archival selection, which no limit in this paper escapes. Grey: the spectral-class composition of the Gaia~DR3 objects within 40\,pc that carry a temperature. Blue: the same for the searched sample. Counts are printed above each bar. The sample is enriched in F and G stars by factors of four and three and depleted in M~dwarfs by a factor two, so \NMSearched {} of the \NMCensus {} classified M~dwarfs within 40\,pc carry a searched window. Because M~dwarfs host most of the habitable-zone planets in the solar neighbourhood, this is the single most important limitation on what the null result means (\S \ref {sec:bias})}{figure.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces The archival selection by spectral class, including the coverage that matters. $N_{40\,\rm  pc}$ counts Gaia\nobreakspace  {}DR3 objects within 40\,pc carrying a temperature; $N_{\rm  searched}$ those with at least one searched window; and the last column those with at least one \emph  {Class\nobreakspace  {}A} window, which is the only coverage that can resolve a drifting carrier. 13{} M\nobreakspace  {}dwarfs have Class\nobreakspace  {}A coverage, of 5\,908{} classified within 40\,pc.}}{29}{table.12}\protected@file@percent }
\newlabel{tab:specclass}{{12}{29}{The archival selection by spectral class, including the coverage that matters. $N_{40\,\rm pc}$ counts Gaia~DR3 objects within 40\,pc carrying a temperature; $N_{\rm searched}$ those with at least one searched window; and the last column those with at least one \emph {Class~A} window, which is the only coverage that can resolve a drifting carrier. \NClassAM {} M~dwarfs have Class~A coverage, of \NMCensus {} classified within 40\,pc}{table.12}{}}
