\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces \textbf  {When each analysis decision was fixed, and what had been seen at the time.} The column that matters is the last one. Two decisions were taken with the relevant data already inspected, and are marked as such; the rates and probabilities this paper quotes are therefore \emph  {post hoc} throughout, and no claim of pre-registration is made for any of them. The hold-out is the one component reserved by a rule written and committed before the windows it selects were examined.}}{34}{table.18}\protected@file@percent }
\newlabel{tab:decisions}{{18}{34}{\textbf {When each analysis decision was fixed, and what had been seen at the time.} The column that matters is the last one. Two decisions were taken with the relevant data already inspected, and are marked as such; the rates and probabilities this paper quotes are therefore \emph {post hoc} throughout, and no claim of pre-registration is made for any of them. The hold-out is the one component reserved by a rule written and committed before the windows it selects were examined}{table.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Line-attribution audit through the frame chain of \S  \ref  {sec:frames}: the three line-attributed windows, and a Class\nobreakspace  {}A $\beta $\nobreakspace  {}Pictoris Band\nobreakspace  {}6 window that carries no stage-1 flag yet shows the same CO component. Topocentric offsets are observed minus catalogued laboratory rest frequency \citep  {Pickett1998}, so a negative offset means the observed frequency lies below rest. The barycentric correction is the Earth-ephemeris term at the execution-block mid-time, signed so that the stellar-frame offset is the topocentric offset \emph  {minus} this column \emph  {plus} $v_{\rm  sys}$. The AU\nobreakspace  {}Mic systemic velocity is catalogued \citep  {Fouque2018}. For $\beta $\nobreakspace  {}Pictoris we adopt $v_{\rm  sys}=+20.0\pm 0.7$\,km\,s$^{-1}$ \citep  {Matra2017} rather than the \emph  {Gaia}\nobreakspace  {}DR3 value of $+16.84$\,km\,s$^{-1}$ \citep  {GaiaDR3}, because the star is an A6V rotator inside the hot-star template regime in which DR3 radial velocities carry a known systematic \citep  {Blomme2023}.}}{34}{table.19}\protected@file@percent }
\newlabel{tab:bpicaudit}{{19}{34}{Line-attribution audit through the frame chain of \S \ref {sec:frames}: the three line-attributed windows, and a Class~A $\beta $~Pictoris Band~6 window that carries no stage-1 flag yet shows the same CO component. Topocentric offsets are observed minus catalogued laboratory rest frequency \citep {Pickett1998}, so a negative offset means the observed frequency lies below rest. The barycentric correction is the Earth-ephemeris term at the execution-block mid-time, signed so that the stellar-frame offset is the topocentric offset \emph {minus} this column \emph {plus} $v_{\rm sys}$. The AU~Mic systemic velocity is catalogued \citep {Fouque2018}. For $\beta $~Pictoris we adopt $v_{\rm sys}=\VsysBpic \pm \VsysBpicErr $\,km\,s$^{-1}$ \citep {Matra2017} rather than the \emph {Gaia}~DR3 value of $+16.84$\,km\,s$^{-1}$ \citep {GaiaDR3}, because the star is an A6V rotator inside the hot-star template regime in which DR3 radial velocities carry a known systematic \citep {Blomme2023}}{table.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces \textbf  {Activity and multiplicity status of the 2{} hosts of unattributed stage-1 events}, from SIMBAD object-type lists queried 2026 September 22; distances are inverted parallaxes. Activity indicators are X-ray, emission-line, flare and rotational-variability classifications; ``none catalogued'' means SIMBAD carries no such flag, not that the star is known to be inactive.}}{34}{table.20}\protected@file@percent }
\newlabel{tab:hosts}{{20}{34}{\textbf {Activity and multiplicity status of the \HostNTot {} hosts of unattributed stage-1 events}, from SIMBAD object-type lists queried \HostQueried ; distances are inverted parallaxes. Activity indicators are X-ray, emission-line, flare and rotational-variability classifications; ``none catalogued'' means SIMBAD carries no such flag, not that the star is known to be inactive}{table.20}{}}
