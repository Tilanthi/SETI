\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {The crossing ledger.} Every one of the 56{} threshold crossings: its search statistic $T_\star $, the 512-position rank flag (\emph  {scr}), the stellar-frame line attribution under the frozen $\pm 50$\,km\,s$^{-1}$ mask, and the drift-following, continuum-subtracted visibility fit evaluated at its own recorded crossing cell under \emph  {both} reference epochs --- the committed $t_0={\rm  median}(T)$ and the adopted $t_0=T_0$, the search's own --- with $D$ the channel displacement between them. \emph  {ctrl} is the largest real part the same fit returns at the twelve control positions and control frequencies. Bold marks the crossings meeting the pre-committed criterion (Re/$\sigma \ge 4$, $|{\rm  Im}/\sigma |<3$, and above every control), fixed at commit \texttt  {edfcc0d3d7db}{} before any fit was run. The criterion is a consistency check on position and epoch and not a filter (\S  \ref  {sec:vistest}); the chain that disposes of a crossing is the \emph  {chain} column, and Fig.\nobreakspace  {}\ref  {fig:ledgervis} plots the two epochs against one another. \LedgerLegend  }}{11}{table.3}\protected@file@percent }
\newlabel{tab:ledger}{{3}{11}{\textbf {The crossing ledger.} Every one of the \LgNCross {} threshold crossings: its search statistic $T_\star $, the \NCtrl -position rank flag (\emph {scr}), the stellar-frame line attribution under the frozen $\pm \LgMaskKms $\,km\,s$^{-1}$ mask, and the drift-following, continuum-subtracted visibility fit evaluated at its own recorded crossing cell under \emph {both} reference epochs --- the committed $t_0={\rm median}(T)$ and the adopted $t_0=T_0$, the search's own --- with $D$ the channel displacement between them. \emph {ctrl} is the largest real part the same fit returns at the twelve control positions and control frequencies. Bold marks the crossings meeting the pre-committed criterion (Re/$\sigma \ge \LgReMin $, $|{\rm Im}/\sigma |<\LgImMax $, and above every control), fixed at commit \LgCommit {} before any fit was run. The criterion is a consistency check on position and epoch and not a filter (\S \ref {sec:vistest}); the chain that disposes of a crossing is the \emph {chain} column, and Fig.~\ref {fig:ledgervis} plots the two epochs against one another. \LedgerLegend }{table.3}{}}
\newlabel{sec:linecost}{{5.2.5}{11}{Line exclusion: definition and cost}{subsubsection.5.2.5}{}}
