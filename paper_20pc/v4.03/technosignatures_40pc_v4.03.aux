\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces \textbf  {What the control ensemble is worth once its members are required to be independent.} Controls are drawn uniformly in the annulus, so the 512{} positions oversample a field that holds far fewer resolution elements. Selection is greedy in draw order, which is fixed before any statistic is seen; greedy packing is not maximal, so each count is a lower bound. The denominator is 1648{} of the 1655{} released windows --- 597{} 12\,m and 1051{} ACA against 601{} and 1054{} in the survey --- the rest not storing the seed and both annulus radii needed to recover their control draw.}}{32}{table.15}\protected@file@percent }
\newlabel{tab:ctrlsep}{{15}{32}{\textbf {What the control ensemble is worth once its members are required to be independent.} Controls are drawn uniformly in the annulus, so the \NCtrl {} positions oversample a field that holds far fewer resolution elements. Selection is greedy in draw order, which is fixed before any statistic is seen; greedy packing is not maximal, so each count is a lower bound. The denominator is \SepNWin {} of the \NWindows {} released windows --- \SepNTwelveWin {} 12\,m and \SepNSevenWin {} ACA against \NWinTwelveM {} and \NWinSevenM {} in the survey --- the rest not storing the seed and both annulus radii needed to recover their control draw}{table.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces The on-star cell excess, decomposed. Every count here is taken over the 56{} threshold crossings of Table\nobreakspace  {}\ref  {tab:searchspace} with the 12{} stage-1 windows removed, which is why the crossing-window row reads 44{} and not 56. Top: what is observed against an iid-Gaussian budget. Middle: the two multiplicative parts of that factor. Bottom: the same correlation correction applied to the control maxima, which are measured in the same units and calibrate the budget empirically.}}{32}{table.16}\protected@file@percent }
\newlabel{tab:excess}{{16}{32}{The on-star cell excess, decomposed. Every count here is taken over the \NHits {} threshold crossings of Table~\ref {tab:searchspace} with the \NStageOneWin {} stage-1 windows removed, which is why the crossing-window row reads \NHitWindowsRest {} and not \NHits . Top: what is observed against an iid-Gaussian budget. Middle: the two multiplicative parts of that factor. Bottom: the same correlation correction applied to the control maxima, which are measured in the same units and calibrate the budget empirically}{table.16}{}}
