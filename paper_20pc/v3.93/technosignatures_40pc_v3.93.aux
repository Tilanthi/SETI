\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Every false-alarm expectation quoted in this paper, and what each one predicts.} The first six predict the number of windows in which a no-signal position would \emph  {rank first} among the control ensemble; they differ in sample, denominator and whether the measured tail excess and the within-block clustering are included, and they are pipeline diagnostics. None of them predicts the observed quantity, because a stage-1 event also requires the position to reach the trigger. The last row imposes that condition and is therefore the only row whose expectation may be compared with an observed count; it is the comparison used in the abstract, in \S  \ref  {sec:technosearch} and in the conclusions. The two kinds of bracket are not the same quantity and are punctuated differently: square brackets give a bootstrap interval on the \emph  {expectation}, round brackets the 95 per cent interval of the predicted \emph  {count} under that expectation.}}{16}{table.5}\protected@file@percent }
\newlabel{tab:falsealarm}{{5}{16}{\textbf {Every false-alarm expectation quoted in this paper, and what each one predicts.} The first six predict the number of windows in which a no-signal position would \emph {rank first} among the control ensemble; they differ in sample, denominator and whether the measured tail excess and the within-block clustering are included, and they are pipeline diagnostics. None of them predicts the observed quantity, because a stage-1 event also requires the position to reach the trigger. The last row imposes that condition and is therefore the only row whose expectation may be compared with an observed count; it is the comparison used in the abstract, in \S \ref {sec:technosearch} and in the conclusions. The two kinds of bracket are not the same quantity and are punctuated differently: square brackets give a bootstrap interval on the \emph {expectation}, round brackets the 95 per cent interval of the predicted \emph {count} under that expectation}{table.5}{}}
