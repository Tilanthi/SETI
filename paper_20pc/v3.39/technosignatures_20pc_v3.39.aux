\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Recovery of high per-integration-S/N injected carriers as a function of dwell fraction, pooling injected amplitudes $\geq 4\sigma $ per integration, from 3\,888{} trials over 12{} real windows. Recovery rises with dwell: a continuously transmitting carrier is the easiest case, not the hardest. This experiment establishes the dependence on temporal occupancy, not the absolute completeness at the survey detection threshold (that is the end-to-end campaign of Fig.\nobreakspace  {}\ref  {fig:compsurface}).}}{11}{table.4}\protected@file@percent }
\newlabel{tab:dwell}{{4}{11}{Recovery of high per-integration-S/N injected carriers as a function of dwell fraction, pooling injected amplitudes $\geq 4\sigma $ per integration, from \NDwellTrials {} trials over \NDwellWin {} real windows. Recovery rises with dwell: a continuously transmitting carrier is the easiest case, not the hardest. This experiment establishes the dependence on temporal occupancy, not the absolute completeness at the survey detection threshold (that is the end-to-end campaign of Fig.~\ref {fig:compsurface})}{table.4}{}}
