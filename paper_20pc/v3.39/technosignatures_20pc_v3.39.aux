\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Line-of-sight acceleration and drift rate at 93.1\,GHz for circular orbits of short-period planets (periods and semimajor axes from the NASA Exoplanet Archive), against the adopted drift-rate search domain of 12--13\,Hz\,s$^{-1}$\,GHz$^{-1}$ ($|a_{\rm  los}|=3.6$--$3.9$\,m\,s$^{-2}$): transmitters on the innermost TRAPPIST-1 planets sit at or beyond it. Eccentricity raises the peak line-of-sight acceleration over the circular value by up to $(1{+}e)/(1{-}e)^{2}$ at periastron: $1.4\times $ at $e=0.1$, $1.9\times $ at $e=0.2$, so planets within a factor ${\sim }2$ of the ceiling -- the borderline rows -- move outside the searched domain at modest eccentricity; the circular-orbit entries should be read with this margin.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:orbital}{{3}{8}{Line-of-sight acceleration and drift rate at 93.1\,GHz for circular orbits of short-period planets (periods and semimajor axes from the NASA Exoplanet Archive), against the adopted drift-rate search domain of 12--13\,Hz\,s$^{-1}$\,GHz$^{-1}$ ($|a_{\rm los}|=3.6$--$3.9$\,m\,s$^{-2}$): transmitters on the innermost TRAPPIST-1 planets sit at or beyond it. Eccentricity raises the peak line-of-sight acceleration over the circular value by up to $(1{+}e)/(1{-}e)^{2}$ at periastron: $1.4\times $ at $e=0.1$, $1.9\times $ at $e=0.2$, so planets within a factor ${\sim }2$ of the ceiling -- the borderline rows -- move outside the searched domain at modest eccentricity; the circular-orbit entries should be read with this margin}{table.3}{}}
\newlabel{eq:drift}{{3}{8}{The search statistic, and the words used for its output}{equation.4.3}{}}
