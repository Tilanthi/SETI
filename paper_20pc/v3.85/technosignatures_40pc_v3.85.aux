\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Line-attribution audit through the frame \relax \fontsize  {7}{8}\selectfont  chain of \S  \ref  {sec:frames}: the three line-attributed windows, and the Class\nobreakspace  {}A $\beta $\nobreakspace  {}Pictoris Band\nobreakspace  {}6 window that is no stage-1 outlier yet shows the same CO component. Topocentric offsets are observed minus catalogued laboratory rest frequency \citep  {Pickett1998}, so a negative offset means the observed frequency lies below rest. The barycentric correction is the Earth-ephemeris term at the execution-block mid-time. The AU\nobreakspace  {}Mic systemic velocity is catalogued \citep  {Fouque2018}. For $\beta $\nobreakspace  {}Pictoris we adopt $v_{\rm  sys}=+20.0\pm 0.7$\,km\,s$^{-1}$ \citep  {Matra2017} rather than the \emph  {Gaia}\nobreakspace  {}DR3 value of $+16.84$\,km\,s$^{-1}$ \citep  {GaiaDR3}, because the star is an A6V rotator inside the hot-star template regime in which DR3 radial velocities carry a known systematic \citep  {Blomme2023}.}}{37}{table.22}\protected@file@percent }
\newlabel{tab:bpicaudit}{{22}{37}{Line-attribution audit through the frame \scriptsize chain of \S \ref {sec:frames}: the three line-attributed windows, and the Class~A $\beta $~Pictoris Band~6 window that is no stage-1 outlier yet shows the same CO component. Topocentric offsets are observed minus catalogued laboratory rest frequency \citep {Pickett1998}, so a negative offset means the observed frequency lies below rest. The barycentric correction is the Earth-ephemeris term at the execution-block mid-time. The AU~Mic systemic velocity is catalogued \citep {Fouque2018}. For $\beta $~Pictoris we adopt $v_{\rm sys}=\VsysBpic \pm \VsysBpicErr $\,km\,s$^{-1}$ \citep {Matra2017} rather than the \emph {Gaia}~DR3 value of $+16.84$\,km\,s$^{-1}$ \citep {GaiaDR3}, because the star is an A6V rotator inside the hot-star template regime in which DR3 radial velocities carry a known systematic \citep {Blomme2023}}{table.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Exchangeability of the 512-position control ensemble by stratum, over 1655{} windows. Boxes give the per-window control maximum, black diamonds the median on-star peak, and $p$ the Kolmogorov--Smirnov test of the per-window rank against $U(0,1)$. \emph  {(a)} by ALMA band, with the window count under each label; \emph  {(b)} by channelisation class, fine ($<5$\,MHz) against coarse. The ensemble tracks the on-star statistic in every band, but both channelisation classes depart from uniformity: fine $D=0.150$, $p<10^{-4}$ over 403{} windows, and coarse $D=0.050$, $p=0.004$ over 1252. The departure is not the flagged windows' doing --- removing all 71{} fine crossings leaves $p=0.002$ --- and \S  \ref  {sec:radial} identifies the radial noise gradient as the cause.}}{37}{figure.13}\protected@file@percent }
\newlabel{fig:ctrldiag}{{13}{37}{Exchangeability of the \NCtrl -position control ensemble by stratum, over \NWindows {} windows. Boxes give the per-window control maximum, black diamonds the median on-star peak, and $p$ the Kolmogorov--Smirnov test of the per-window rank against $U(0,1)$. \emph {(a)} by ALMA band, with the window count under each label; \emph {(b)} by channelisation class, fine ($<5$\,MHz) against coarse. The ensemble tracks the on-star statistic in every band, but both channelisation classes depart from uniformity: fine $D=\KsFineD $, $p\KsFineP $ over \KsFineN {} windows, and coarse $D=\KsCoarseD $, $p\KsCoarseP $ over \KsCoarseN . The departure is not the flagged windows' doing --- removing all \KsFineCrossN {} fine crossings leaves $p\KsFineNoCrossP $ --- and \S \ref {sec:radial} identifies the radial noise gradient as the cause}{figure.13}{}}
