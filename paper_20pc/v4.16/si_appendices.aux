\@writefile{lot}{\contentsline {table}{\numberline {D1}{\ignorespaces \textbf  {The crossing ledger, from which every disposition in this paper can be reproduced.} All 56{} threshold crossings, including the 4{} in the failing block of \S  \ref  {sec:bdblock}. Every row is the primary crossing of its window; the 21{} secondary crossings are not listed individually, and the three{} of them the mask does not attribute are described in \S  \ref  {sec:technosearch}. The columns are the star, its execution block, the ALMA band, the crossing frequency as the correlator delivered it and the same frequency in the star's rest frame, the search statistic $T_\star $, the largest statistic $T_{\rm  ctrl}$ among the window's 512{} control positions, the nearest masked transition and the stellar-frame offset $\Delta v_\star $ from it, then the recurrence test: $n_{\rm  rep}$ covering repeat blocks spanning $\Delta t$ days, the statistic $T_{\rm  pers}$ a carrier persisting at the discovery flux would have produced at the predicted stellar-frame cell, the statistic $T_{\rm  rep}$ measured there at the carried drift, and the exclusion of Eq.\nobreakspace  {}\ref  {eq:excl}, which three of these columns reproduce, two of them also giving the limit defined in Appendix\nobreakspace  {}\ref  {app:radius}. Where the emission is present again in a covering block the test returns a recovery and not an exclusion, so both $T_{\rm  rep}$ and $\sigma _{\rm  excl}$ are blank and the disposition says which it was. $T_\star $ and $T_{\rm  ctrl}$ come from the same measurement of the same window; $T_{\rm  ctrl}$ gates nothing and says only which crossing was examined first, and the drift-maximised reading of the cell is given in Table\nobreakspace  {}\ref  {tab:cand} for the two leading events and is not tabulated for the rest. Rows whose window is data-quality flagged (\S  \ref  {sec:blockquality}) are marked, and on those $T_{\rm  pers}$ and the exclusion are withheld: both are built from the discovery amplitude, and in a window whose control ring stands as high as its star that amplitude cannot be assigned to a point source at the star. 1{} of those rows lies outside the failing block --- HD\nobreakspace  {}48370, a resolved disc --- and is withheld for that reason and not for its block. A crossing is attributed where $|\Delta v_\star |\le 50$\,km\,s$^{-1}$ and the coinciding species is one such a system could plausibly emit; a dagger marks the 3{} rows that satisfy the first condition and not the second, for the reason given in Appendix\nobreakspace  {}\ref  {app:linemask}. The transition named is the nearest in that frame, so far from every transition it is the magnitude and not the name that carries information. Block identifiers omit the constant \texttt  {A002\_} prefix.}}{10}{table.D.1}\protected@file@percent }
\newlabel{tab:ledger}{{D1}{10}{\textbf {The crossing ledger, from which every disposition in this paper can be reproduced.} All \EvNCrossRaw {} threshold crossings, including the \EvNCrossFlag {} in the failing block of \S \ref {sec:bdblock}. Every row is the primary crossing of its window; the \CkNSecondary {} secondary crossings are not listed individually, and the \CkNSecUnattrWord {} of them the mask does not attribute are described in \S \ref {sec:technosearch}. The columns are the star, its execution block, the ALMA band, the crossing frequency as the correlator delivered it and the same frequency in the star's rest frame, the search statistic $T_\star $, the largest statistic $T_{\rm ctrl}$ among the window's \NCtrl {} control positions, the nearest masked transition and the stellar-frame offset $\Delta v_\star $ from it, then the recurrence test: $n_{\rm rep}$ covering repeat blocks spanning $\Delta t$ days, the statistic $T_{\rm pers}$ a carrier persisting at the discovery flux would have produced at the predicted stellar-frame cell, the statistic $T_{\rm rep}$ measured there at the carried drift, and the exclusion of Eq.~\ref {eq:excl}, which three of these columns reproduce, two of them also giving the limit defined in Appendix~\ref {app:radius}. Where the emission is present again in a covering block the test returns a recovery and not an exclusion, so both $T_{\rm rep}$ and $\sigma _{\rm excl}$ are blank and the disposition says which it was. $T_\star $ and $T_{\rm ctrl}$ come from the same measurement of the same window; $T_{\rm ctrl}$ gates nothing and says only which crossing was examined first, and the drift-maximised reading of the cell is given in Table~\ref {tab:cand} for the two leading events and is not tabulated for the rest. Rows whose window is data-quality flagged (\S \ref {sec:blockquality}) are marked, and on those $T_{\rm pers}$ and the exclusion are withheld: both are built from the discovery amplitude, and in a window whose control ring stands as high as its star that amplitude cannot be assigned to a point source at the star. \BkFlagNCrossOther {} of those rows lies outside the failing block --- \BkFlagOtherStar , a resolved disc --- and is withheld for that reason and not for its block. A crossing is attributed where $|\Delta v_\star |\le \MaskHalfKms $\,km\,s$^{-1}$ and the coinciding species is one such a system could plausibly emit; a dagger marks the \MkNSODecide {} rows that satisfy the first condition and not the second, for the reason given in Appendix~\ref {app:linemask}. The transition named is the nearest in that frame, so far from every transition it is the magnitude and not the name that carries information. Block identifiers omit the constant \texttt {A002\_} prefix}{table.D.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {D2}{\ignorespaces \emph  {The crossing ledger, continued.} The remaining 28{} of the 56{} threshold crossings, in the same order and with the same columns as Table\nobreakspace  {}\ref  {tab:ledger}, whose caption defines them. These too are primary crossings, one to a window.}}{10}{table.D.2}\protected@file@percent }
\newlabel{tab:ledgercont}{{D2}{10}{\emph {The crossing ledger, continued.} The remaining \CxLedgerPartTwo {} of the \EvNCrossRaw {} threshold crossings, in the same order and with the same columns as Table~\ref {tab:ledger}, whose caption defines them. These too are primary crossings, one to a window}{table.D.2}{}}
