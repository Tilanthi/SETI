\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Band-by-band cost of the molecular-line mask. Union: unique sky frequency searched in the band. Masked: the part of it lying within $\pm 50$\,km\,s$^{-1}$ of a catalogued transition of a masked species, evaluated in the stellar rest frame. Left: what a technosignature search can still occupy. The mask is excluded search space and not a veto (\S  \ref  {sec:linecost}); the loss is concentrated in the bands where CO and SO sit.}}{21}{table.8}\protected@file@percent }
\newlabel{tab:maskband}{{8}{21}{Band-by-band cost of the molecular-line mask. Union: unique sky frequency searched in the band. Masked: the part of it lying within $\pm \MaskHalfKms $\,km\,s$^{-1}$ of a catalogued transition of a masked species, evaluated in the stellar rest frame. Left: what a technosignature search can still occupy. The mask is excluded search space and not a veto (\S \ref {sec:linecost}); the loss is concentrated in the bands where CO and SO sit}{table.8}{}}
