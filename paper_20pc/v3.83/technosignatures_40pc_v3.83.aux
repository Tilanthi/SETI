\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Line-attribution audit through the frame \relax \fontsize  {7}{8}\selectfont  chain of \S  \ref  {sec:frames}: the three line-attributed windows, and the Class\nobreakspace  {}A $\beta $\nobreakspace  {}Pictoris Band\nobreakspace  {}6 window that is no stage-1 outlier yet shows the same CO component. Topocentric offsets are observed minus catalogued laboratory rest frequency \citep  {Pickett1998}, so a negative offset means the observed frequency lies below rest. The barycentric correction is the Earth-ephemeris term at the execution-block mid-time. The AU\nobreakspace  {}Mic systemic velocity is catalogued \citep  {Fouque2018}. For $\beta $\nobreakspace  {}Pictoris we adopt $v_{\rm  sys}=+20.0\pm 0.7$\,km\,s$^{-1}$ \citep  {Matra2017} rather than the \emph  {Gaia}\nobreakspace  {}DR3 value of $+16.84$\,km\,s$^{-1}$ \citep  {GaiaDR3}, because the star is an A6V rotator inside the hot-star template regime in which DR3 radial velocities carry a known systematic \citep  {Blomme2023}.}}{32}{table.15}\protected@file@percent }
\newlabel{tab:bpicaudit}{{15}{32}{Line-attribution audit through the frame \scriptsize chain of \S \ref {sec:frames}: the three line-attributed windows, and the Class~A $\beta $~Pictoris Band~6 window that is no stage-1 outlier yet shows the same CO component. Topocentric offsets are observed minus catalogued laboratory rest frequency \citep {Pickett1998}, so a negative offset means the observed frequency lies below rest. The barycentric correction is the Earth-ephemeris term at the execution-block mid-time. The AU~Mic systemic velocity is catalogued \citep {Fouque2018}. For $\beta $~Pictoris we adopt $v_{\rm sys}=\VsysBpic \pm \VsysBpicErr $\,km\,s$^{-1}$ \citep {Matra2017} rather than the \emph {Gaia}~DR3 value of $+16.84$\,km\,s$^{-1}$ \citep {GaiaDR3}, because the star is an A6V rotator inside the hot-star template regime in which DR3 radial velocities carry a known systematic \citep {Blomme2023}}{table.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Every window the region-maximum statistic flags, under both statistics, so the difference between them can be audited across all of them. $S_{\rm  reg}$: region maximum of Eq.\nobreakspace  {}\ref  {eq:tstar} over $n_{\rm  src}=135$ positions; $T_\star $: the symmetric single-position statistic; `ctrl max', `ring max': the largest control statistic under each. The $\nu $ column is each window's \emph  {centre}; the crossing frequency differs by up to 0.85\,GHz, and Table\nobreakspace  {}\ref  {tab:flagged} carries $\nu _{\rm  cross}$. For CP$-$72\nobreakspace  {}2713 the region maximum already lay on the star, so the two coincide.}}{32}{table.16}\protected@file@percent }
\newlabel{tab:bothstats}{{16}{32}{Every window the region-maximum statistic flags, under both statistics, so the difference between them can be audited across all of them. $S_{\rm reg}$: region maximum of Eq.~\ref {eq:tstar} over $n_{\rm src}=135$ positions; $T_\star $: the symmetric single-position statistic; `ctrl max', `ring max': the largest control statistic under each. The $\nu $ column is each window's \emph {centre}; the crossing frequency differs by up to 0.85\,GHz, and Table~\ref {tab:flagged} carries $\nu _{\rm cross}$. For CP$-$72~2713 the region maximum already lay on the star, so the two coincide}{table.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces The survey rescored under both repairs. ``Survives'' is the largest stellar debit $m(0)$, in units of each window's own control scale, at which the star still exceeds every detrended control; it is a property of the window and assumes neither debit. For reference the conservative debit is 0.15$\,\sigma $ and the debit that centres the calibration-sample rank distribution is 0.32$\,\sigma $, and a window survives whichever debit is smaller than its entry. No window is added by either repair.}}{32}{table.17}\protected@file@percent }
\newlabel{tab:repaired}{{17}{32}{The survey rescored under both repairs. ``Survives'' is the largest stellar debit $m(0)$, in units of each window's own control scale, at which the star still exceeds every detrended control; it is a property of the window and assumes neither debit. For reference the conservative debit is \RmDebitCons $\,\sigma $ and the debit that centres the calibration-sample rank distribution is \RmDebitCal $\,\sigma $, and a window survives whichever debit is smaller than its entry. No window is added by either repair}{table.17}{}}
